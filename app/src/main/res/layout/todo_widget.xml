    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="班级消息待办 · 待办"
        android:textColor="#202522"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:text="点按勾选或取消"
        android:textColor="#747D78"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <TextView
            android:id="@+id/widget_mark_1"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="○"
            android:textColor="#33846B"
            android:textSize="24sp"
            android:contentDescription="点按标记完成" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView
                android:id="@+id/widget_task_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="待办事项"
                android:textColor="#202522"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/widget_meta_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="截止时间"
                android:textColor="#747D78"
                android:textSize="12sp" />
