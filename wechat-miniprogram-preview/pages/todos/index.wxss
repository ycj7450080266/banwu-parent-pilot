.topline { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 2rpx 30rpx; }
.date-line { margin-top: 10rpx; color: #777b86; font-size: 22rpx; }
.settings-entry { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 50%; color: #3260e6; background: #e9edff; font-size: 23rpx; }
.sync-card { display: flex; align-items: flex-start; margin-bottom: 28rpx; background: #eef8f3; border-color: #dcefe5; padding: 24rpx; }
.sync-dot { flex: 0 0 14rpx; width: 14rpx; height: 14rpx; margin: 9rpx 18rpx 0 0; border-radius: 50%; background: #269d63; }
.sync-copy { flex: 1; }
.sync-title { font-size: 25rpx; font-weight: 600; }
.sync-sub { margin-top: 7rpx; color: #747b78; font-size: 21rpx; line-height: 1.5; }
.sync-arrow { color: #87928c; font-size: 42rpx; line-height: 32rpx; }
.count-row { display: flex; align-items: baseline; margin: 10rpx 2rpx 20rpx; }
.count { font-size: 30rpx; font-weight: 650; }
.count-note { margin-left: 14rpx; font-size: 21rpx; }
.filters { display: flex; gap: 14rpx; margin-bottom: 26rpx; }
.filter { padding: 14rpx 26rpx; border-radius: 30rpx; color: #686d78; background: #eceef3; font-size: 22rpx; }
.filter.selected { color: #fff; background: #20232b; }
.task-list { display: flex; flex-direction: column; gap: 16rpx; }
.task-card { display: flex; align-items: center; gap: 18rpx; padding: 25rpx 22rpx; }
.task-main { flex: 1; min-width: 0; }
.task-title { overflow: hidden; color: #1d2027; font-size: 29rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.task-done { color: #858a93; text-decoration: line-through; }
.task-meta { margin-top: 9rpx; color: #777b86; font-size: 21rpx; }
.complete { flex: 0 0 auto; min-width: 104rpx; height: 68rpx; margin: 0; padding: 0 18rpx; border-radius: 20rpx; color: #fff; background: #3260e6; font-size: 22rpx; line-height: 68rpx; }
.complete::after { border: 0; }
.complete-done { color: #484b55; background: #eff1f6; }
.empty-card { margin-top: 2rpx; padding: 46rpx 32rpx; text-align: center; }
.empty-mark { width: 72rpx; height: 72rpx; margin: 0 auto 18rpx; border-radius: 24rpx; color: #3260e6; background: #eef1ff; font-size: 40rpx; line-height: 72rpx; }
.empty-title { font-size: 29rpx; font-weight: 600; }
.empty-copy { margin-top: 14rpx; color: #777b86; font-size: 22rpx; line-height: 1.65; }
.form-card { margin-top: 20rpx; }
.form-title { margin-bottom: 16rpx; font-weight: 600; }
.field { height: 82rpx; margin: 12rpx 0; padding: 0 22rpx; border: 1rpx solid #e4e6ec; border-radius: 20rpx; background: #fff; font-size: 25rpx; }
.form-actions { display: flex; gap: 14rpx; margin-top: 14rpx; }
.form-cancel, .form-save { flex: 1; min-height: 82rpx; font-size: 24rpx; }
.add-button { display: flex; align-items: center; justify-content: center; height: 88rpx; margin-top: 22rpx; border: 1rpx dashed #bfc7e8; border-radius: 24rpx; color: #3260e6; background: #f1f3ff; }
.privacy-note { margin: 25rpx 3rpx 145rpx; color: #888c95; font-size: 20rpx; line-height: 1.5; }
.bottom-nav { position: fixed; right: 0; bottom: 0; left: 0; display: flex; justify-content: space-around; padding: 16rpx 0 calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #eceef2; background: rgba(255,255,255,.97); }
.nav-item { display: flex; flex-direction: column; align-items: center; gap: 4rpx; color: #8b8f98; font-size: 28rpx; }
.nav-item text { font-size: 19rpx; }
.nav-active { color: #3260e6; }

